APP_ENV=dev
APP_SECRET=changeme
APP_ENCRYPT_KEY=changeme
DATABASE_URL="mysql://nineboamp:changeme@mariadb:3306/nineboamp"
MCP_SECRET=changeme
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null

APP_NAME="nineboamp"
APP_NOREPLY=admin@noreply.fr
APP_ADMIN="admin"
APP_ADMIN_EMAIL="admin@example.com"

MODE_AUTH=SQL

CAS_HOST=auth.cadoles.com
CAS_PORT=443
CAS_PATH=/cas
CAS_USERNAME=uid
CAS_MAIL=mail
CAS_LASTNAME=lastname
CAS_FIRSTNAME=firstname

OIDC_ISSUER=https://forge.cadoles.com
OIDC_CLIENTID=changeme
OIDC_CLIENTSECRET=changeme
OIDC_REDIRECTURI=http://192.168.10.225:8027
OIDC_MAILATTRIBUTE=email
OIDC_USERNAMEATTRIBUTE=preferred_username
OIDC_LASTNAMEATTRIBUTE=family_name
OIDC_FIRSTNAMEATTRIBUTE=given_name

###> AI / LLM ###
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
AI_API_KEY=changeme
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
###< AI / LLM ###

STORAGE_DSN="local://uploads"
STORAGE_S3=0

###> RocketChat ###
ROCKETCHAT_URL=https://rocket.cadoles.com
ROCKETCHAT_USER_ID=
ROCKETCHAT_AUTH_TOKEN=
ROCKETCHAT_CHANNEL=#marches-publics
###< RocketChat ###
# Proxies de confiance (X-Forwarded-For/Host/Proto/Port).
# Par defaut on fait confiance a tout le monde : ces applications ne sont joignables
# que via le reverse proxy. Restreindre par deploiement (IP/CIDR du proxy) dans .env.local.
TRUSTED_PROXIES=0.0.0.0/0
###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###
