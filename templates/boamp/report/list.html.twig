{% extends 'base.html.twig' %}

{% block title %}= {{ title }}{% endblock %}

{% block body %}
<h1>{{ title }}</h1>

<div class="mb-3">
    <a href="{{ path('app_market_list') }}" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Marchés</a>
</div>

<div class="dataTable_wrapper">
    <table class="table table-striped table-bordered table-hover" id="dataTables" style="width:100%" data-order-col="0" data-order-dir="desc">
        <thead>
            <tr>
                <th>Date</th>
                <th>Trouvés</th>
                <th>Qualifiés</th>
                <th>Notifiés</th>
                <th>Durée</th>
                <th>Erreur</th>
                <th>AO qualifiés</th>
            </tr>
        </thead>
        <tbody>
            {% for report in reports %}
            <tr class="{{ report.error ? 'table-danger' : '' }}">
                <td data-order="{{ report.executedAt|date('Y-m-d H:i') }}">{{ report.executedAt|date('d/m/Y H:i') }}</td>
                <td>{{ report.marketsFound ?: 0 }}</td>
                <td>{{ report.marketsQualified ?: 0 }}</td>
                <td>{{ report.marketsNotified ?: 0 }}</td>
                <td>{{ report.duration ? report.duration|date('H:i:s') : '-' }}</td>
                <td>{% if report.error %}<span class="text-danger small">{{ report.error }}</span>{% else %}<i class="fas fa-check text-success"></i>{% endif %}</td>
                <td>
                    {% if report.qualifiedMarketsJson and report.qualifiedMarkets is not empty %}
                        {% set qualified = report.qualifiedMarkets %}
                        <ul class="small mb-0 ps-3">
                        {% for market in qualified %}
                            <li>
                                {% if market.id %}
                                <a href="{{ path('app_market_show', {id: market.id}) }}">{{ market.idweb|default(market.idweb) }}</a>
                                {% else %}
                                {{ market.idweb|default('N/A') }}
                                {% endif %}
                                — {{ (market.title|default('')|slice(0, 50)) ~ (market.title|default('')|length > 50 ? '…' : '') }}
                                <span class="badge bg-{{ market.priority|default('C') == 'A' ? 'success' : market.priority|default('C') == 'B' ? 'warning' : 'secondary' }}">{{ market.score|default(0) }}/100</span>
                            </li>
                        {% endfor %}
                        </ul>
                    {% else %}-{% endif %}
                </td>
            </tr>
            {% else %}
            <tr class="empty-row">
                <td colspan="7" class="text-center text-muted">Aucun rapport.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
