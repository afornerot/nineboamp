{% extends 'base.html.twig' %}

{% block title %} = {{title}}{% endblock %}

{% block body %}
    <h1>{{title}}</h1>

    <div class="position-relative">
        {% if routedelete is defined and routedelete %}{% include 'include/delete_button.html.twig' with {route: routedelete, id: form.vars.value.id, tokenId: 'delete-competence' ~ form.vars.value.id, classes: 'delete-abs'} %}{% endif %}

        {{ form_start(form) }}

        {{ form_widget(form.submit) }}
        <a href="{{ path(routecancel) }}" class="btn btn-secondary ms-1">Annuler</a>

        {% include('include/error.html.twig') %}

        <div class="card mt-3">
            <div class="card-header">Informations</div>
            <div class="card-body">
                {{ form_row(form.category) }}
                {{ form_row(form.label) }}
                {{ form_row(form.position) }}
                {{ form_row(form.active) }}
            </div>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}

{% block localscript %}
    <script>
        $(document).ready(function() {
            $("#competence_label").focus();
        });
    </script>
{% endblock %}
