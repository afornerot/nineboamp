{% extends 'base.html.twig' %}

{% block title %} = {{title}}{% endblock %}

{% block body %}
    <h1>{{title}}</h1>
    <p class="text-muted">
        Ces éléments décrivent l'entreprise à l'IA. Ils sont insérés dans les prompts de scoring, de rapport et de chat
        à la place de <code>{{ '{{competences}}' }}</code>. Une modification s'applique dès le prochain appel.
    </p>
    <a href="{{ path(routesubmit) }}" class="btn btn-success">Ajouter</a>
    <form method="post" action="{{ path('app_admin_competence_suggest') }}" class="d-inline ms-1" onsubmit="this.querySelector('button').disabled = true; this.querySelector('button').innerHTML = '<i class=&quot;fas fa-spinner fa-spin&quot;></i> Analyse du catalogue…';">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('suggest-competence') }}">
        <button type="submit" class="btn btn-outline-primary" title="L'IA lit les fiches produits et propose des compétences ou des exclusions manquantes. Rien n'est enregistré sans validation."><i class="fas fa-magic"></i> Suggérer depuis le catalogue</button>
    </form>

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger mt-3">{{ message }}</div>
    {% endfor %}

    {% if suggestions is not null %}
        <div class="card mt-3 border-primary">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Suggestions de l'IA, à relire avant ajout</span>
                <form method="post" action="{{ path('app_admin_competence_suggest_dismiss') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('suggest-competence') }}">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Fermer</button>
                </form>
            </div>
            <div class="card-body p-0">
                {% if suggestions|length == 0 %}
                    <p class="text-muted m-3">Aucune suggestion restante.</p>
                {% else %}
                    <table class="table table-striped mb-0">
                        <tbody>
                            {% for key, suggestion in suggestions %}
                                <tr>
                                    <td width="190px" class="text-nowrap">
                                        <a href="{{ path(routesubmit, {suggestion: key}) }}" class="btn btn-sm btn-success">Ajouter</a>
                                        <form method="post" action="{{ path('app_admin_competence_suggest_dismiss') }}" class="d-inline">
                                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('suggest-competence') }}">
                                            <input type="hidden" name="key" value="{{ key }}">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Ignorer</button>
                                        </form>
                                    </td>
                                    <td width="220px">{{ categories[suggestion.category] }}</td>
                                    <td>
                                        {{ suggestion.label }}
                                        {% if suggestion.reason %}<br><small class="text-muted">{{ suggestion.reason }}</small>{% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {% for category, categoryLabel in categories %}
        <div class="card mt-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>{{ categoryLabel }}</span>
                <a href="{{ path(routesubmit, {category: category}) }}" class="btn btn-sm btn-outline-success">Ajouter</a>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <tbody>
                        {% set found = false %}
                        {% for competence in competences %}
                            {% if competence.category == category %}
                                {% set found = true %}
                                <tr class="{{ competence.active ? '' : 'text-muted' }}">
                                    <td width="70px"><a href="{{ path(routeupdate, {id: competence.id}) }}" title="Modifier"><i class="fas fa-file fa-2x"></i></a></td>
                                    <td width="70px">{{ competence.position }}</td>
                                    <td>{{ competence.label }}</td>
                                    <td width="110px">{% if not competence.active %}<span class="badge bg-secondary">Inactive</span>{% endif %}</td>
                                </tr>
                            {% endif %}
                        {% endfor %}
                        {% if not found %}
                            <tr><td class="text-muted">Aucun élément.</td></tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endfor %}

    <div class="card mt-3">
        <div class="card-header">Aperçu du texte transmis à l'IA</div>
        <div class="card-body">
            <pre class="mb-0" style="white-space: pre-wrap;">{{ preview }}</pre>
        </div>
    </div>
{% endblock %}
