{% extends 'base.html.twig' %}

{% block title %} = {{title}}{% endblock %}

{% block body %}
    <h1>{{title}}</h1>

    <div class="dataTable_wrapper">
        <table class="table table-striped table-bordered table-hover" id="dataTables" style="width:100%" data-order-col="1" data-order-dir="asc">
            <thead>
            <tr>
                <th width="70px" class="no-sort">Action</th>
                <th>Prochaine exécution</th>
                <th>Commande</th>
                <th>Description</th>
                <th>Statut</th>
            </tr>
            </thead>
            <tbody>
                {% for cron in crons %}
                    <tr>
                        <td>
                            <a href="{{path(routeupdate,{id:cron.id})}}"><i class="fas fa-file fa-2x"></i></a>
                        </td>
                        <td>{{cron.nextexecdate|date("d/m/Y H:i")}}</td>
                        <td>{{cron.command}}</td>
                        <td>{{cron.description}}</td>
                        <td>{{cron.statutlabel}}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
