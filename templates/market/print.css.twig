{# Auto-generated CSS bundle with embedded fonts. Do not edit manually. #}

/* === FONTS (base64) === */
@font-face { font-family: "Open Sans"; font-weight: normal; font-style: normal; src: url(data:font/ttf;base64,) format("truetype"); }
@font-face { font-family: "Open Sans"; font-weight: bold; font-style: normal; src: url(data:font/ttf;base64,) format("truetype"); }
@font-face { font-family: "Space Mono"; font-weight: normal; font-style: normal; src: url(data:font/ttf;base64,) format("truetype"); }
@font-face { font-family: "Space Mono"; font-weight: bold; font-style: normal; src: url(data:font/ttf;base64,) format("truetype"); }
@font-face { font-family: "Hack"; font-weight: normal; font-style: normal; src: url(data:font/ttf;base64,) format("truetype"); }
@font-face { font-family: "Hack"; font-weight: bold; font-style: normal; src: url(data:font/ttf;base64,) format("truetype"); }

:root {
  --navy: #0F2F3F;
  --cyan: #6FC7E2;
  --blue: #329ACA;
  --orange: #FF974A;
  --text: #1a1a1a;
  --text-soft: #555;
  --border: #ddd;
}

@page { margin: 1.5cm; size: A4; }
* { box-sizing: border-box; }

body {
  font-family: "Open Sans", Helvetica, Arial, sans-serif;
  font-size: 9pt;
  color: var(--text);
  line-height: 1;
  margin: 0;
  padding: 0;
}

/* === HEADERS === */
h1 {
  font-family: "Space Mono", monospace;
  font-size: 26pt !important; 
  margin: 0 0 12pt 0;
  color: var(--navy);
  font-weight: 700;
  letter-spacing: -0.5pt;
  line-height: 1.05;
}
h2 {
  font-family: "Space Mono", monospace;
  font-size: 19pt !important;
  margin: 28pt 0 12pt 0;
  padding-bottom: 6pt;
  border-bottom: 3pt solid var(--blue);
  color: var(--blue);
  text-transform: uppercase;
  letter-spacing: 1pt;
  line-height: 1.1;
}
h3 {
  font-family: "Space Mono", monospace;
  font-size: 15pt !important;
  margin: 20pt 0 8pt 0;
  color: var(--blue);
  text-transform: uppercase;
  letter-spacing: 0.5pt;
  line-height: 1.1;
}

/* === HEADER === */
.header {
  border-bottom: 2pt solid var(--navy);
  padding-bottom: 10pt;
  margin-bottom: 14pt;
  background-color: rgba(15, 47, 63, 0.04);
}
.header .subtitle {
  font-size: 9pt;
  color: var(--text-soft);
  margin-top: 2pt;
}

/* === META TABLE === */
.meta-table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 14pt;
}
.meta-table td {
  padding: 5pt 8pt;
  vertical-align: top;
  border: 0.5pt solid var(--border);
}
.meta-table td.label {
  width: 25%;
  font-family: "Space Mono", monospace;
  font-weight: 700;
  background-color: rgba(50, 154, 202, 0.1);
  color: var(--blue);
  text-transform: uppercase;
  font-size: 8pt;
  letter-spacing: 0.5pt;
}

/* === BADGES === */
.badge {
  display: inline-block;
  padding: 1pt 8pt;
  border-radius: 3pt;
  font-family: "Space Mono", monospace;
  font-weight: 700;
  font-size: 8pt;
  letter-spacing: 0.5pt;
  color: #fff;
}
.badge-a { background-color: var(--blue); }
.badge-b { background-color: var(--orange); }
.badge-c { background-color: var(--text-soft); }

/* === PRODUCTS TABLE === */
.products-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 6pt;
}
.products-table th {
  font-family: "Space Mono", monospace;
  background-color: var(--navy);
  color: #fff;
  text-align: left;
  padding: 5pt 7pt;
  border: 0.5pt solid var(--navy);
  font-size: 8.5pt;
  text-transform: uppercase;
  letter-spacing: 0.5pt;
}
.products-table td {
  padding: 5pt 7pt;
  border: 0.5pt solid var(--cyan);
  vertical-align: top;
}
.products-table tr:nth-child(even) td {
  background-color: rgba(111, 199, 226, 0.1);
}

.description, .comment, .explanation {
  margin-top: 4pt;
  text-align: justify;
}

/* === CHAT === */
.chat-section {
  margin-top: 8pt;
}
.chat-msg {
  margin-bottom: 10pt;
  padding: 8pt 12pt;
  font-size: 8.5pt;
  border-left: 3pt solid var(--cyan);
  background-color: #f8fbfd;
}
.chat-user {
  border-left-color: var(--blue);
  background-color: rgba(50, 154, 202, 0.08);
}
.chat-assistant {
  border-left-color: var(--orange);
  background-color: rgba(255, 151, 74, 0.04);
}
.chat-role {
  font-family: "Space Mono", monospace;
  font-weight: 700;
  font-size: 7.5pt;
  color: var(--navy);
  margin-bottom: 4pt;
  text-transform: uppercase;
  letter-spacing: 0.5pt;
}
.chat-sources {
  font-size: 7pt;
  color: var(--text-soft);
  margin-top: 4pt;
  font-style: italic;
  font-family: "Space Mono", monospace;
}
.chat-sources strong { color: var(--blue); }

/* === REPORT CONTENT === */
.report-content {
  margin-top: 4pt;
}
.report-content h1 {
  font-size: 14pt;
  margin: 14pt 0 6pt 0;
  padding-bottom: 3pt;
  border-bottom: 1.5pt solid var(--blue);
  color: var(--blue);
  text-transform: uppercase;
  letter-spacing: 0.5pt;
}
.report-content h2 {
  font-size: 11pt;
  margin: 12pt 0 4pt 0;
  border-bottom: 1pt solid var(--cyan);
  padding-bottom: 2pt;
  color: var(--blue);
  text-transform: uppercase;
  letter-spacing: 0.5pt;
}
.report-content h3 {
  font-size: 9.5pt;
  margin: 8pt 0 3pt 0;
  color: var(--blue);
  text-transform: uppercase;
  letter-spacing: 0.5pt;
}
.report-content p {
  margin: 4pt 0;
  text-align: justify;
}
.report-content ul, .report-content ol {
  margin: 4pt 0;
  padding-left: 18pt;
}
.report-content li {
  margin-bottom: 2pt;
}
.report-content table {
  width: 100%;
  border-collapse: collapse;
  margin: 6pt 0;
  font-size: 8pt;
}
.report-content th {
  font-family: "Space Mono", monospace;
  background-color: var(--navy);
  color: #fff;
  text-align: left;
  padding: 4pt 6pt;
  border: 0.5pt solid var(--navy);
  text-transform: uppercase;
  letter-spacing: 0.5pt;
}
.report-content td {
  padding: 4pt 6pt;
  border: 0.5pt solid var(--cyan);
  vertical-align: top;
}
.report-content tr:nth-child(even) td {
  background-color: rgba(111, 199, 226, 0.1);
}
.report-content blockquote {
  border-left: 3pt solid var(--orange);
  margin: 6pt 0;
  padding: 6pt 10pt;
  background-color: rgba(255, 151, 74, 0.06);
  font-style: normal;
}
.report-content blockquote strong {
  color: var(--orange);
}
.report-content code {
  font-family: "Hack", monospace;
  background-color: #f8fbfd;
  color: var(--navy);
  padding: 1pt 4pt;
  font-size: 8pt;
}
.report-content pre {
  font-family: "Hack", monospace;
  background-color: #f8fbfd;
  color: var(--navy);
  padding: 6pt;
  border: 0.5pt solid var(--cyan);
  font-size: 8pt;
  white-space: pre-wrap;
  word-break: break-word;
}
.report-content strong {
  color: var(--blue);
  font-weight: 700;
}

.risk-high { color: #d33; font-weight: 700; }
.risk-medium { color: var(--orange); font-weight: 700; }
.risk-low { color: var(--blue); font-weight: 700; }

/* === FOOTER === */
/* === COVER PAGE === */
.cover-page {
  page-break-after: always;
  background-color: #fff;
  color: var(--text);
  padding: 60pt 40pt 40pt 40pt;
  border: 4pt solid var(--cyan);
  margin: 0 0 16pt 0;
  position: relative;
  font-family: "Open Sans", Helvetica, Arial, sans-serif;
}
.cover-eyebrow {
  font-family: "Space Mono", monospace;
  font-size: 9pt;
  letter-spacing: 4pt;
  text-transform: uppercase;
  color: var(--cyan);
  border-bottom: 1pt solid var(--cyan);
  padding-bottom: 8pt;
  display: inline-block;
}
.cover-title {
  font-family: "Space Mono", monospace;
  font-size: 11pt;
  font-weight: 700;
  color: var(--blue);
  letter-spacing: 0.5pt;
  margin: 0;
  display: inline;
}
.cover-market {
  font-family: "Open Sans", Helvetica, Arial, sans-serif;
  font-size: 26pt;
  font-weight: 700;
  color: var(--orange);
  line-height: 0.7;
  margin: 18pt 0 24pt 0;
  letter-spacing: -0.5pt;
}
.cover-kpi-row {
  display: table;
  width: 100%;
  border-collapse: separate;
  border-spacing: 8pt 0;
}
.cover-kpi {
  display: table-cell;
  background-color: rgba(111, 199, 226, 0.1);
  border: 1pt solid var(--cyan);
  padding: 10pt 12pt;
  width: 25%;
  vertical-align: top;
}
.cover-kpi-label {
  font-family: "Space Mono", monospace;
  font-size: 7pt;
  line-height: 1;
  letter-spacing: 1.5pt;
  text-transform: uppercase;
  color: var(--blue);
  margin-bottom: 4pt;
}
.cover-kpi-value {
  font-family: "Open Sans", Helvetica, Arial, sans-serif;
  font-size: 11pt;
  font-weight: 700;
  color: var(--navy);
  line-height: 1;
}
.cover-spacer {
  height: 30pt;
}
.cover-footer-meta {
  font-family: "Space Mono", monospace;
  font-size: 7pt;
  letter-spacing: 1pt;
  text-transform: uppercase;
  color: var(--text-soft);
  margin-top: 30pt;
  text-align: right;
}


.footer {
  margin-top: 24pt;
  padding-top: 8pt;
  border-top: 0.5pt solid var(--cyan);
  font-size: 8pt;
  color: var(--text-soft);
  text-align: center;
}

.section { page-break-inside: avoid; }
.page-break { page-break-before: always; }
