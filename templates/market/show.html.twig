{% extends 'base.html.twig' %}

{% block title %}= {{ title }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-gavel"></i> {{ title|length > 80 ? title|slice(0, 80) ~ '…' : title }}</h3>
    <div>
        <a href="{{ path('app_market_list') }}" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
</div>

{% for message in app.flashes('success') %}
    <div class="alert alert-success">{{ message }}</div>
{% endfor %}
{% for message in app.flashes('error') %}
    <div class="alert alert-danger">{{ message }}</div>
{% endfor %}

<div class="row">
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Informations</span>
                <div>
                    <a href="{{ path('app_market_export_pdf', {id: market.id}) }}" target="_blank" class="btn btn-sm btn-danger" title="Exporter en PDF"><i class="fas fa-file-pdf"></i> PDF</a>
                    <button type="button" id="btn-rescore" class="btn btn-sm btn-warning" title="Requalifier" onclick="startRescore()"><i class="fas fa-sync-alt"></i> Requalifier</button>
                    <button class="btn btn-sm btn-outline-light" id="btn-toggle-edit" type="button" title="Modifier">
                        <i class="fas fa-pen"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div id="info-view">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Acheteur</dt>
                        <dd class="col-sm-8">{{ market.buyer }}</dd>

                        <dt class="col-sm-4">Deadline</dt>
                        <dd class="col-sm-8">{{ market.deadline ? market.deadline|date('d/m/Y') : '-' }}</dd>

                        <dt class="col-sm-4">Montant</dt>
                        <dd class="col-sm-8">{{ market.amount }}</dd>

                        <dt class="col-sm-4">Score</dt>
                        <dd class="col-sm-8">{{ market.score }}/100</dd>

                        <dt class="col-sm-4">Priorité</dt>
                        <dd class="col-sm-8">
                            {% if market.priority == 'A' %}<span class="badge bg-success">{{ market.priority }}</span>
                            {% elseif market.priority == 'B' %}<span class="badge bg-warning">{{ market.priority }}</span>
                            {% else %}<span class="badge bg-secondary">{{ market.priority }}</span>{% endif %}
                        </dd>

                        {% if market.explanation %}
                        <dt class="col-sm-4">Analyse IA</dt>
                        <dd class="col-sm-8"><small>{{ market.explanation }}</small></dd>
                        {% endif %}

                        <dt class="col-sm-4">Statut</dt>
                        <dd class="col-sm-8"><span class="badge bg-primary">{{ market.statuslabel }}</span></dd>

                        <dt class="col-sm-4">URL</dt>
                        <dd class="col-sm-8"><a href="{{ market.url }}" target="_blank" class="text-truncate d-inline-block" style="max-width: 100%;">BOAMP</a></dd>
                    </dl>
                </div>

                <div id="info-edit" class="d-none">
                    {{ form_start(editForm) }}
                    {% for child in editForm.children %}
                        {% if child.vars.name != 'submit' %}
                            {{ form_row(child) }}
                        {% endif %}
                    {% endfor %}
                    <div class="mt-2 d-flex gap-2">
                        {{ form_widget(editForm.submit) }}
                        <button type="button" class="btn btn-secondary btn-sm" id="btn-cancel-edit">Annuler</button>
                    </div>
                    {{ form_end(editForm) }}
                </div>
            </div>
        </div>

        <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-description" type="button" role="tab">
                    <i class="fas fa-file-alt"></i>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-comment" type="button" role="tab">
                    <i class="fas fa-comment"></i>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-products" type="button" role="tab">
                    <i class="fas fa-box"></i>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-files" type="button" role="tab">
                    <i class="fas fa-paperclip"></i>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-indexed-docs" type="button" role="tab" id="tab-indexed-docs-btn">
                    <i class="fas fa-database"></i>
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="tab-description" role="tabpanel">
                <div class="card">
                    <div class="card-header">Description</div>
                    <div class="card-body">{{ market.description|nl2br }}</div>
                </div>
            </div>

            <div class="tab-pane fade" id="tab-comment" role="tabpanel">
                <div class="card">
                    <div class="card-header">Commentaire</div>
                    <div class="card-body">
                        {% if market.comment %}
                            <div id="comment-md-source" class="d-none">{{ market.comment }}</div>
                            <div id="comment-md-target"></div>
                        {% else %}
                            <p class="text-muted text-center py-4">Aucun commentaire.</p>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="tab-products" role="tabpanel">
                {% if market.marketProducts|length > 0 %}
                    {% for mp in market.marketProducts %}
                    <div class="card mb-2">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span>{{ mp.product.name }}</span>
                            <span class="badge bg-secondary">{{ mp.score }}/100</span>
                        </div>
                        <div class="card-body py-2 px-3">
                            {% if mp.relevance %}<p class="text-muted small mb-0 mt-1">{{ mp.relevance }}</p>{% endif %}
                            {% if mp.scoreDetails %}<p class="text-muted small mb-0"><i class="fas fa-info-circle"></i> {{ mp.scoreDetails }}</p>{% endif %}
                        </div>
                    </div>
                    {% endfor %}
                {% else %}
                    <div class="card">
                        <div class="card-header">Produits</div>
                        <div class="card-body text-muted text-center py-4">Aucun produit correspondant.</div>
                    </div>
                {% endif %}
            </div>

            <div class="tab-pane fade" id="tab-files" role="tabpanel">
                {{ render(path("bninefiles_files",{domain:'boamp',id:market.id, editable:1})) }}
            </div>

            <div class="tab-pane fade" id="tab-indexed-docs" role="tabpanel">
                <div class="card">
                    <div class="card-header"><i class="fas fa-database me-2"></i>Documents indexés par amoxtli</div>
                    <div class="card-body" id="indexed-docs-body">
                        <div class="text-center text-muted py-3">
                            <i class="fas fa-spinner fa-spin"></i> Chargement...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card" style="height: calc(100vh - 160px); display: flex; flex-direction: column;">
            <div class="card-header d-flex align-items-center">
                <i class="fas fa-robot me-2"></i>
                <span>Assistant</span>
                {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin_market_chat_debug', {id: market.id}) }}" class="btn btn-sm btn-outline-secondary ms-auto" target="_blank" title="Debug RAG">
                    <i class="fas fa-bug"></i>
                </a>
                {% endif %}
            </div>
            <div class="card-body flex-grow-1 overflow-auto" id="chat-messages" style="min-height: 0;">
                <div id="chat-empty" class="text-muted text-center py-5">
                    <i class="fas fa-robot fa-3x mb-3"></i>
                    <p>Posez vos questions sur ce marché.<br>L'assistant se base sur les documents indexés.</p>
                </div>
            </div>
            <div class="card-footer">
                <form id="chat-form" class="d-flex gap-2">
                    <input type="text" class="form-control" id="chat-input" placeholder="Votre question..." autocomplete="off">
                    <button type="submit" class="btn btn-primary" id="chat-send">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    #chat-messages .chat-msg {
        max-width: 85%;
        margin-bottom: 0.75rem;
        padding: 0.6rem 0.9rem;
        border-radius: 1rem;
        font-size: 0.9rem;
        line-height: 1.45;
        word-break: break-word;
    }
    #chat-messages .chat-msg-user {
        margin-left: auto;
        background: var(--bs-primary);
        color: #fff;
        border-bottom-right-radius: 0.25rem;
    }
    #chat-messages .chat-msg-assistant {
        margin-right: auto;
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-bottom-left-radius: 0.25rem;
    }
    #chat-messages .chat-msg-assistant pre {
        background: var(--bs-tertiary-bg) !important;
        color: #000 !important;
        padding: 0.5rem;
        border-radius: 0.25rem;
        overflow-x: auto;
        font-size: 0.82rem;
        white-space: pre-wrap;
        word-wrap: break-word;
    }
    #chat-messages .chat-msg-assistant pre code {
        background: transparent !important;
        color: inherit !important;
        padding: 0;
    }
    #chat-messages .chat-msg-assistant code {
        font-size: 0.85rem;
        background: var(--bs-tertiary-bg);
        color: #000;
        padding: 0.1rem 0.3rem;
        border-radius: 0.2rem;
    }
    #chat-messages .chat-sources {
        font-size: 0.75rem;
        color: var(--bs-secondary-color);
        margin-top: 0.3rem;
    }
    #chat-messages .chat-sources i { margin-right: 0.2rem; }
    #chat-input:disabled { opacity: 0.6; }
    #chat-send:disabled { opacity: 0.6; }
    .btn-delete-msg {
        float: right;
        background: transparent;
        border: none;
        color: var(--bs-secondary-color);
        font-size: 0.75rem;
        padding: 0.1rem 0.3rem;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.15s ease-in;
    }
    .chat-msg:hover .btn-delete-msg { opacity: 0.6; }
    .btn-delete-msg:hover { opacity: 1 !important; color: #dc3545; }
</style>

<script>
(function() {
    var chatMessages = document.getElementById('chat-messages');
    var chatForm = document.getElementById('chat-form');
    var chatInput = document.getElementById('chat-input');
    var chatSend = document.getElementById('chat-send');
    var chatEmpty = document.getElementById('chat-empty');
    var sending = false;

    function escapeHtml(text) {
        var d = document.createElement('div');
        d.textContent = text;
        return d.innerHTML;
    }

    function renderMarkdown(text) {
        if (typeof marked !== 'undefined') {
            return marked.parse(text);
        }
        return escapeHtml(text).replace(/\n/g, '<br>');
    }

    function addMessage(role, content, sources, createdAt, messageId) {
        if (chatEmpty) {
            chatEmpty.remove();
            chatEmpty = null;
        }
        var div = document.createElement('div');
        div.className = 'chat-msg chat-msg-' + role;
        div.dataset.messageId = messageId || '';

        var deleteBtn = messageId
            ? '<button type="button" class="btn-delete-msg" title="Supprimer ce message"><i class="fas fa-times"></i></button>'
            : '';

        var html = '<div>' + deleteBtn + renderMarkdown(content) + '</div>';
        if (sources && sources.length > 0) {
            html += '<div class="chat-sources"><i class="fas fa-file-alt"></i> ' +
                sources.map(escapeHtml).join(', ') + '</div>';
        }
        div.innerHTML = html;
        chatMessages.appendChild(div);
        chatMessages.scrollTop = chatMessages.scrollHeight;
        return div;
    }

    chatMessages.addEventListener('click', function(e) {
        var btn = e.target.closest('.btn-delete-msg');
        if (!btn) return;
        var msgDiv = btn.closest('.chat-msg');
        var messageId = msgDiv.dataset.messageId;
        if (!messageId) return;

        if (!confirm('Supprimer ce message de la conversation ?')) return;

        var deleteUrl = '{{ path("app_market_chat_delete", {id: market.id, messageId: 0}) }}'.replace(/\/0$/, '/' + messageId);

        fetch(deleteUrl, {
            method: 'DELETE',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.error) {
                alert('Erreur : ' + data.error);
                return;
            }
            msgDiv.remove();
        })
        .catch(function() {
            alert('Erreur de connexion.');
        });
    });

    function setLoading(loading) {
        sending = loading;
        chatInput.disabled = loading;
        chatSend.disabled = loading;
        if (loading) {
            chatInput.placeholder = 'Recherche en cours...';
        } else {
            chatInput.placeholder = 'Votre question...';
            chatInput.focus();
        }
    }

    function loadHistory() {
        fetch('{{ path("app_market_chat_history", {id: market.id}) }}')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.messages && data.messages.length > 0) {
                    data.messages.forEach(function(m) {
                        addMessage(m.role, m.content, m.sources, m.createdAt, m.id);
                    });
                }
            });
    }

    chatForm.addEventListener('submit', function(e) {
        e.preventDefault();
        if (sending) return;

        var message = chatInput.value.trim();
        if (!message) return;

        var userDiv = addMessage('user', message);
        chatInput.value = '';
        setLoading(true);

        fetch('{{ path("app_market_chat", {id: market.id}) }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: message })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.userMessageId) {
                userDiv.dataset.messageId = data.userMessageId;
                var innerDiv = userDiv.querySelector('div');
                if (innerDiv && !innerDiv.querySelector('.btn-delete-msg')) {
                    innerDiv.insertAdjacentHTML('afterbegin', '<button type="button" class="btn-delete-msg" title="Supprimer ce message"><i class="fas fa-times"></i></button>');
                }
            }

            if (data.pending && data.jobId) {
                var assistantDiv = addMessage('assistant', 'Analyse en cours... ⏳', [], null, null);
                pollForResult(data.jobId, assistantDiv);
            } else if (data.reply) {
                addMessage('assistant', data.reply, data.sources || [], null, data.assistantMessageId || null);
                setLoading(false);
            } else {
                addMessage('assistant', 'Erreur de réponse.', [], null, null);
                setLoading(false);
            }
        })
        .catch(function() {
            addMessage('assistant', 'Erreur de connexion. Veuillez réessayer.');
            setLoading(false);
        });
    });

    function pollForResult(jobId, assistantDiv) {
        fetch('{{ path("app_market_chat_poll", {id: market.id, jobId: "JOB_ID"}) }}'.replace('JOB_ID', jobId), {
            method: 'GET',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.status === 'done') {
                var innerDiv = assistantDiv.querySelector('div');
                if (innerDiv) {
                    innerDiv.innerHTML = renderMarkdown(data.result?.answer || '');
                }
                if (!innerDiv.querySelector('.btn-delete-msg')) {
                    innerDiv.insertAdjacentHTML('afterbegin', '<button type="button" class="btn-delete-msg" title="Supprimer ce message"><i class="fas fa-times"></i></button>');
                }
                if (data.assistantMessageId) {
                    assistantDiv.dataset.messageId = data.assistantMessageId;
                }
                setLoading(false);
            } else if (data.status === 'error') {
                var innerDiv = assistantDiv.querySelector('div');
                if (innerDiv) {
                    innerDiv.innerHTML = '<em style="color: red;">Erreur: ' + escapeHtml(data.result?.error || 'Une erreur est survenue') + '</em>';
                }
                setLoading(false);
            } else {
                setTimeout(function() { pollForResult(jobId, assistantDiv); }, 2000);
            }
        })
        .catch(function() {
            var innerDiv = assistantDiv.querySelector('div');
            if (innerDiv) {
                innerDiv.innerHTML = '<em style="color: red;">Erreur de connexion.</em>';
            }
            setLoading(false);
        });
    }

    loadHistory();
})();
</script>

<script>
(function() {
    var rescoreBtn = null;
    var rescoreOriginalHtml = '';
    var rescoreMarketId = {{ market.id }};

    function startRescore() {
        if (!confirm('Relancer le scoring IA sur ce marché ?')) return;
        if (!rescoreBtn) rescoreBtn = document.getElementById('btn-rescore');
        rescoreOriginalHtml = rescoreBtn.innerHTML;
        rescoreBtn.disabled = true;
        rescoreBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Analyse en cours...';

        console.log('Starting rescore for market', rescoreMarketId);
        fetch('/user/market/' + rescoreMarketId + '/rescore', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({})
        })
        .then(function(r) {
            console.log('Rescore response status:', r.status);
            return r.json();
        })
        .then(function(data) {
            console.log('Rescore response data:', data);
            if (data.pending && data.jobId) {
                pollRescore(data.jobId);
            } else if (data.error) {
                alert('Erreur: ' + data.error);
                rescoreBtn.disabled = false;
                rescoreBtn.innerHTML = rescoreOriginalHtml;
            } else {
                console.warn('Unexpected rescore response:', data);
                alert('Réponse inattendue du serveur');
                rescoreBtn.disabled = false;
                rescoreBtn.innerHTML = rescoreOriginalHtml;
            }
        })
        .catch(function(err) {
            console.error('Rescore fetch error:', err);
            alert('Erreur de connexion: ' + err.message);
            rescoreBtn.disabled = false;
            rescoreBtn.innerHTML = rescoreOriginalHtml;
        });
    }
    window.startRescore = startRescore;

    function pollRescore(jobId) {
        fetch('/user/market/' + rescoreMarketId + '/rescore/poll/' + jobId)
        .then(function(r) {
            if (!r.ok) {
                throw new Error('HTTP ' + r.status);
            }
            return r.json();
        })
        .then(function(data) {
            console.log('Poll result:', data);
            if (data.status === 'done') {
                rescoreBtn.disabled = false;
                rescoreBtn.innerHTML = rescoreOriginalHtml;
                location.reload();
            } else if (data.status === 'error') {
                alert('Erreur lors du scoring: ' + (data.error || 'Une erreur est survenue'));
                rescoreBtn.disabled = false;
                rescoreBtn.innerHTML = rescoreOriginalHtml;
            } else if (data.status === 'pending' || data.status === 'not_found') {
                setTimeout(function() { pollRescore(jobId); }, 2000);
            }
        })
        .catch(function(err) {
            console.error('Poll error (retrying):', err);
            setTimeout(function() { pollRescore(jobId); }, 5000);
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        rescoreBtn = document.getElementById('btn-rescore');

        var btnToggle = document.getElementById('btn-toggle-edit');
        var btnCancel = document.getElementById('btn-cancel-edit');
        var infoView = document.getElementById('info-view');
        var infoEdit = document.getElementById('info-edit');
        var easyMDEInstance = null;

        function initOrRefreshMDE() {
            if (easyMDEInstance) {
                easyMDEInstance.codemirror.refresh();
                return;
            }
            if (typeof EasyMDE === 'undefined') return;
            var ta = infoEdit.querySelector('textarea');
            if (ta) {
                easyMDEInstance = new EasyMDE({ element: ta, spellChecker: false, status: false, minHeight: '150px' });
            }
        }

        if (btnToggle) {
            btnToggle.addEventListener('click', function() {
                infoView.classList.add('d-none');
                infoEdit.classList.remove('d-none');
                setTimeout(initOrRefreshMDE, 50);
            });
        }

        if (btnCancel) {
            btnCancel.addEventListener('click', function() {
                infoEdit.classList.add('d-none');
                infoView.classList.remove('d-none');
            });
        }

        var mdSource = document.getElementById('comment-md-source');
        var mdTarget = document.getElementById('comment-md-target');
        if (mdSource && mdTarget && typeof marked !== 'undefined') {
            mdTarget.innerHTML = marked.parse(mdSource.textContent);
        }

        var indexedDocsTab = document.getElementById('tab-indexed-docs-btn');
        var indexedDocsBody = document.getElementById('indexed-docs-body');
        var indexedDocsLoaded = false;

        function formatBytes(bytes) {
            if (!bytes || bytes <= 0) return '?';
            var units = ['B', 'KB', 'MB', 'GB'];
            var i = 0;
            var size = bytes;
            while (size >= 1024 && i < units.length - 1) { size /= 1024; i++; }
            return size.toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
        }

        function formatDate(isoString) {
            if (!isoString) return '?';
            var d = new Date(isoString);
            if (isNaN(d.getTime())) return isoString;
            return String(d.getDate()).padStart(2, '0') + '/' + String(d.getMonth() + 1).padStart(2, '0') + '/' + d.getFullYear() + ' ' + String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
        }

        function escapeHtml(text) {
            if (!text) return '';
            var d = document.createElement('div');
            d.textContent = text;
            return d.innerHTML;
        }

        function renderIndexedDocs(data) {
            if (!indexedDocsBody) return;
            if (!data.available) {
                indexedDocsBody.innerHTML = '<div class="alert alert-warning mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Le binaire amoxtli n\u2019est pas disponible sur le serveur.</div>';
                return;
            }
            if (!data.initialized) {
                indexedDocsBody.innerHTML = '<div class="alert alert-info mb-0"><i class="fas fa-info-circle me-2"></i>Workspace amoxtli pas encore initialisé.</div>';
                return;
            }
            if (!data.documents || data.documents.length === 0) {
                indexedDocsBody.innerHTML = '<div class="alert alert-info mb-0"><i class="fas fa-info-circle me-2"></i>Aucun fichier indexé.</div>';
                return;
            }
            var html = '<table class="table table-sm mb-0"><thead><tr><th>Fichier</th><th>Type</th><th>Taille</th><th>Indexé le</th></tr></thead><tbody>';
            data.documents.forEach(function(doc) {
                var icon = '<i class="fas fa-file-alt me-2"></i>';
                if (doc.extension === 'pdf') icon = '<i class="fas fa-file-pdf me-2 text-danger"></i>';
                else if (doc.extension === 'docx' || doc.extension === 'doc') icon = '<i class="fas fa-file-word me-2 text-primary"></i>';
                html += '<tr><td>' + icon + escapeHtml(doc.filename || 'N/A') + '</td><td><span class="badge bg-secondary">' + ((doc.extension || '?').toUpperCase()) + '</span></td><td>' + formatBytes(doc.size) + '</td><td><small>' + formatDate(doc.indexed_at) + '</small></td></tr>';
            });
            html += '</tbody></table><div class="text-muted small mt-2">' + data.documents.length + ' document(s) indexé(s)</div>';
            indexedDocsBody.innerHTML = html;
        }

        function loadIndexedDocs() {
            if (indexedDocsLoaded) return;
            indexedDocsLoaded = true;
            fetch('{{ path("app_market_indexed_docs", {id: market.id}) }}')
            .then(function(r) { return r.json(); })
            .then(function(data) { renderIndexedDocs(data); })
            .catch(function() {
                if (indexedDocsBody) indexedDocsBody.innerHTML = '<div class="alert alert-danger mb-0">Erreur lors du chargement.</div>';
            });
        }

        if (indexedDocsTab) {
            indexedDocsTab.addEventListener('click', function() { loadIndexedDocs(); });
        }
    });
})();
</script>
{% endblock %}
