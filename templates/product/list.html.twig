{% extends 'base.html.twig' %}

{% block title %}= {{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>
    <a href="{{ path(routesubmit) }}" class="btn btn-success">Ajouter</a>

    <div class="dataTable_wrapper">
        <table class="table table-striped table-bordered table-hover" id="dataTables" style="width:100%" data-order-col="1" data-order-dir="asc">
            <thead>
            <tr>
                <th width="70px" class="no-sort">Action</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Mots-clés</th>
                <th>Secteurs</th>
            </tr>
            </thead>
            <tbody>
                {% for product in products %}
                    <tr>
                        <td><a href="{{ path(routeupdate, {id: product.id}) }}"><i class="fas fa-file fa-2x"></i></a></td>
                        <td><strong>{{ product.name }}</strong></td>
                        <td>{{ product.description ?: '-' }}</td>
                        <td>{{ product.keywords ?: '-' }}</td>
                        <td>{{ product.sectors ?: '-' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {% if products|length == 0 %}
            <div class="text-center text-muted mt-3">Aucun produit. <a href="{{ path(routesubmit) }}">Créer le premier</a></div>
        {% endif %}
    </div>
{% endblock %}
