{% extends 'base.html.twig' %}

{% block body %}
    <form method="post">
        <img src="{{asset("/medias/logo/logo.png")}}" class="login-logo mx-auto d-block my-3" alt="Logo">
        <div class="login-title text-center mb-5 fs-2">{{appName}}</div>
        <div class="card card-body login-card m-auto">
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="mb-3">
                    Vous êtes déjà connecté avec le login {{ app.user.userIdentifier }} = <a href="{{ path('app_logout') }}">Logout</a>
                </div>
            {% endif %}

            <div class="mb-3">
                <label for="username">Login</label>
                <input type="text" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="username" required autofocus>
            </div>

            <div class="mb-3">
                <label for="password">Password</label>
                <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="btn btn-lg btn-primary mt-2" type="submit">
                Valider
            </button>
        </div>
    </form>
{% endblock %}

{% block localscript %}
    <script>
        $(document).ready(function () {
            $("#username").focus();
        });
    </script>
{% endblock %}
